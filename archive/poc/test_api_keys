import os
import requests
from dotenv import load_dotenv

load_dotenv()

def test_api_keys():
    # 1. 한국은행 API 테스트 (현재 기준금리 조회 예시)
    bok_key = os.getenv("BOK_API_KEY")
    bok_url = f"https://ecos.bok.or.kr/api/StatisticSearch/{bok_key}/json/kr/1/1/722Y001/D/20260101/20260501/0101000"
    
    # 2. DART API 테스트 (종목 리스트 조회 예시)
    fss_key = os.getenv("FSS_API_KEY")
    fss_url = f"https://opendart.fss.or.kr/api/corpCode.xml?crtfc_key={fss_key}"

    print("API 연결 테스트 시작")
    
    # BOK 테스트
    res_bok = requests.get(bok_url)
    if res_bok.status_code == 200:
        print("BOK API: 연결 성공")
    
    # FSS 테스트
    res_fss = requests.get(fss_url)
    if res_fss.status_code == 200:
        print("FSS DART API: 연결 성공")

if __name__ == "__main__":
    test_api_keys()