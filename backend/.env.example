APP_ENV=local
PERF_DIAGNOSTICS_ENABLED=false
AUTH_ENABLED=true

# Replace with your runtime datastore credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
REDIS_URL=redis://:PASSWORD@HOST:PORT/DB_NUMBER

# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/auth/google/callback
# Generate a distinct high-entropy secret; rotate with the optional PREVIOUS pair.
AI_BACKTEST_SCOPE_HMAC_PRIMARY=replace-with-a-high-entropy-secret
AI_BACKTEST_SCOPE_HMAC_PRIMARY_VERSION=v1
# AI_BACKTEST_SCOPE_HMAC_PREVIOUS=previous-high-entropy-secret
# AI_BACKTEST_SCOPE_HMAC_PREVIOUS_VERSION=v0
# Raw model audit storage is fail-closed by default. Keep disabled until Gate B signs admissions.
AI_BACKTEST_RAW_AUDIT_ENABLED=false
# AI_BACKTEST_RAW_AUDIT_ADMISSION_HMAC_SECRET=replace-with-a-distinct-high-entropy-secret
# AI_BACKTEST_RAW_AUDIT_ADMISSION_HMAC_KEY_VERSION=v1
# AI_BACKTEST_RAW_AUDIT_ADMISSION_TOKEN=replace-with-a-signed-gate-b-admission-token
# AI_BACKTEST_RAW_AUDIT_ADMISSION_AUDIENCE=quantagent.backend.raw-audit
# AI_BACKTEST_RAW_AUDIT_EVIDENCE_ID=gate-b-evidence-id
# AI_BACKTEST_RAW_AUDIT_DEPLOYMENT_REVISION=deployment-revision

AUTH_PUBLIC_BACKEND_ORIGIN=http://127.0.0.1:8000
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173
AUTH_ALLOWED_HOSTS=localhost,127.0.0.1
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# OAuth start is bounded per client. Enable forwarded headers only with explicit proxy peers.
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# AUTH_TRUSTED_PROXY_HEADERS=true
# AUTH_TRUSTED_PROXY_HOSTS=127.0.0.1,::1

# Email delivery is dark by default. Server rollout may be allowlist or production only after operator approval.
EMAIL_ROLLOUT_MODE=disabled
EMAIL_DELIVERY_ENABLED=false
EMAIL_REPORT_COMPLETED_TRIGGER_ENABLED=false
EMAIL_DELIVERY_WORKER_ENABLED=false
EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-server-secret
BREVO_SENDER_EMAIL=replace-with-authenticated-sender@qt-agent.kro.kr
BREVO_SENDER_NAME=QuantAgent
BREVO_SANDBOX_MODE=false
EMAIL_PUBLIC_BASE_URL=https://replace-with-public-application-host
EMAIL_UNSUBSCRIBE_ENABLED=false
EMAIL_UNSUBSCRIBE_SIGNING_SECRET=replace-with-server-secret
EMAIL_UNSUBSCRIBE_BASE_URL=https://replace-with-public-application-host

# Deprecated local-only canary aliases retained for controlled developer verification.
EMAIL_LOCAL_LIVE_SEND_ENABLED=false
EMAIL_LOCAL_RECIPIENT_ALLOWLIST=
